# Godot 4
.godot/
/android/

# Every other gs-* addon is a separate repository. For local development they are
# symlinked; a consumer copies the ones it wants instead:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
#
# These links must stay ignored. A committed symlink is checked out as a text
# FILE by Git on Windows without Developer Mode, so Godot finds a 30-byte file
# where an addon should be and every class_name in it fails to resolve.
/addons/gs_core
/addons/gs_auth

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/

# gs-sql: the suites drive the SQL store with its drivers. The addon itself reaches a
# driver duck-typed and does not need it.
/addons/gs_sql
/addons/gs_cloud
/addons/gs_moderation
/addons/gs_server
/addons/gs_voice
